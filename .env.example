# Configure these in Vercel Project Settings → Environment Variables.
RESEND_API_KEY=
EMAIL_FROM="The Africa Plug <connect@theafricaplug.com>"
EMAIL_CONNECT=connect@theafricaplug.com

# Optional Cloudflare Turnstile spam protection. Set both keys together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin access (server-only; configure strong values in Vercel, never commit real secrets).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Supabase Storage for the homepage hero image manager. Keep the service-role key server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=africa-plug-media
