# Configure these in Vercel Project Settings → Environment Variables.
RESEND_API_KEY=
EMAIL_FROM="The Africa Plug <connect@theafricaplug.com>"
EMAIL_CONNECT=connect@theafricaplug.com
EMAIL_ASK=ask@theafricaplug.com
EMAIL_FK=fk@theafricaplug.com

# Optional Cloudflare Turnstile spam protection. Set both keys together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin access (server-only; configure strong values in Vercel, never commit real secrets).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# CMS bridge for Supabase. The bridge secret must match the SHA-256 digest stored in cms_private_config.
SUPABASE_URL=
SUPABASE_ANON_KEY=
CMS_BRIDGE_SECRET=

# Server-side Supabase credential for Store downloads/orders; never expose client-side.
# Prefer a legacy service_role JWT for project/role validation when available.
SUPABASE_SERVICE_ROLE_JWT=
SUPABASE_SERVICE_ROLE_KEY=

# Public hero/media uploads use the connected Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# Newsletter provider (MailerLite is the planned audience platform).
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
MAILERLITE_INTEGRATION_READY=false # Set true only after the MailerLite API integration is implemented and tested.
