/* FILE PATH: src/components/store/StoreCart.tapcart-module.tapcart-css */

.tapcart-root { display: inline-flex; }

/* ---------- Trigger ---------- */
.tapcart-trigger {
  position: relative;
  display: inline-grid;
  place-items: center;
  width: 46px;
  height: 46px;
  padding: 0;
  border: 1px solid rgba(41, 42, 44, .18);
  border-radius: 50%;
  background: #fff;
  color: #292a2c;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(41, 42, 44, .08);
  transition: transform .18s ease, border-color .18s ease, color .18s ease, box-shadow .18s ease;
}
.tapcart-trigger:hover { border-color: #d51f6d; color: #d51f6d; transform: translateY(-1px); box-shadow: 0 6px 16px rgba(213, 31, 109, .18); }
.tapcart-trigger:focus-visible { outline: 2px solid #d51f6d; outline-offset: 3px; }
.tapcart-trigger svg { display: block; }

.tapcart-badge {
  position: absolute;
  top: -5px;
  right: -5px;
  min-width: 20px;
  height: 20px;
  padding: 0 6px;
  border-radius: 999px;
  background: #d51f6d;
  color: #fff;
  font-size: 11px;
  font-weight: 800;
  line-height: 20px;
  text-align: center;
  box-shadow: 0 0 0 2px #fff;
}
.tapcart-badge-pop { animation: tapcart-pop .28s ease; }
@keyframes tapcart-pop { 0% { transform: scale(.6); } 60% { transform: scale(1.18); } 100% { transform: scale(1); } }

/* Mobile-only floating button (the hero cart is hidden on small screens) */
.tapcart-floating {
  position: fixed;
  right: 16px;
  bottom: 18px;
  z-index: 900;
  display: none;
}
.tapcart-floating .tapcart-trigger {
  width: 56px;
  height: 56px;
  background: #292a2c;
  color: #fff;
  border-color: #292a2c;
  box-shadow: 0 10px 26px rgba(0, 0, 0, .28);
}
.tapcart-floating .tapcart-trigger:hover { background: #d51f6d; border-color: #d51f6d; color: #fff; }
@media (max-width: 800px) { .tapcart-floating { display: inline-flex; } }

/* ---------- Drawer ---------- */
.tapcart-overlay {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: flex;
  justify-content: flex-end;
  background: rgba(20, 20, 22, .5);
  backdrop-filter: blur(3px);
  animation: tapcart-fade .2s ease;
}
@keyframes tapcart-fade { from { opacity: 0; } to { opacity: 1; } }

.tapcart-panel {
  display: flex;
  flex-direction: column;
  width: min(460px, 100%);
  height: 100%;
  height: 100dvh;
  background: #fbfaf8;
  color: #292a2c;
  box-shadow: -18px 0 50px rgba(0, 0, 0, .22);
  animation: tapcart-slide .28s cubic-bezier(.2, .8, .2, 1);
}
@keyframes tapcart-slide { from { transform: translateX(40px); opacity: 0; } to { transform: none; opacity: 1; } }

.tapcart-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding: 22px 22px 18px;
  border-bottom: 1px solid rgba(41, 42, 44, .12);
  background: #fff;
}
.tapcart-eyebrow { margin: 0 0 4px; color: #d51f6d; font-size: 10px; font-weight: 900; letter-spacing: .2em; }
.tapcart-title { margin: 0; font-size: 26px; font-weight: 900; letter-spacing: -.04em; line-height: 1.05; }
.tapcart-title span { color: #8a8d93; font-weight: 600; font-size: 18px; letter-spacing: 0; }

.tapcart-close {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  padding: 0;
  border: 1px solid rgba(41, 42, 44, .16);
  border-radius: 50%;
  background: #fff;
  color: #292a2c;
  font-size: 22px;
  line-height: 1;
  cursor: pointer;
  transition: background .15s ease, color .15s ease, border-color .15s ease;
}
.tapcart-close:hover { background: #292a2c; color: #fff; border-color: #292a2c; }
.tapcart-close:focus-visible { outline: 2px solid #d51f6d; outline-offset: 2px; }

.tapcart-body { flex: 1; overflow-y: auto; padding: 18px 22px; display: grid; align-content: start; gap: 14px; }

/* ---------- Items ---------- */
.tapcart-item {
  display: grid;
  grid-template-columns: 76px minmax(0, 1fr) auto;
  gap: 14px;
  align-items: start;
  padding: 14px;
  border: 1px solid rgba(41, 42, 44, .1);
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 1px 2px rgba(41, 42, 44, .04);
}

.tapcart-cover {
  position: relative;
  display: flex;
  align-items: flex-end;
  width: 76px;
  aspect-ratio: .72;
  padding: 8px;
  border-radius: 4px;
  overflow: hidden;
  background: linear-gradient(160deg, #1b2a4a 0%, #4b1d5c 55%, #d51f6d 120%);
  color: #fff;
  box-shadow: 4px 5px 0 rgba(0, 0, 0, .12), inset 4px 0 rgba(0, 0, 0, .18);
}
.tapcart-cover::after { content: ""; position: absolute; left: 8px; bottom: 26px; width: 18px; height: 2px; background: #ff4b9e; }
.tapcart-cover span { font-size: 7px; font-weight: 900; letter-spacing: .12em; line-height: 1.35; }

.tapcart-copy { min-width: 0; }
.tapcart-name { margin: 0 0 3px; font-size: 15px; font-weight: 800; letter-spacing: -.02em; line-height: 1.25; overflow-wrap: anywhere; }
.tapcart-each { margin: 0 0 12px; color: #6b6e75; font-size: 12px; }

.tapcart-controls { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }
.tapcart-stepper {
  display: inline-flex;
  align-items: center;
  border: 1px solid rgba(41, 42, 44, .2);
  border-radius: 999px;
  overflow: hidden;
  background: #fff;
}
.tapcart-stepper button {
  width: 32px;
  height: 32px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #292a2c;
  font-size: 17px;
  line-height: 1;
  cursor: pointer;
  transition: background .15s ease, color .15s ease;
}
.tapcart-stepper button:hover:not(:disabled) { background: #d51f6d; color: #fff; }
.tapcart-stepper button:disabled { color: #b9bbc0; cursor: not-allowed; }
.tapcart-stepper button:focus-visible { outline: 2px solid #d51f6d; outline-offset: -2px; }
.tapcart-stepper output { min-width: 28px; text-align: center; font-size: 13px; font-weight: 800; }

.tapcart-remove {
  padding: 4px 0;
  border: 0;
  background: transparent;
  color: #8a8d93;
  font-size: 12px;
  text-decoration: underline;
  text-underline-offset: 3px;
  cursor: pointer;
}
.tapcart-remove:hover { color: #b42318; }
.tapcart-remove:focus-visible { outline: 2px solid #d51f6d; outline-offset: 2px; }

.tapcart-line-total { font-size: 15px; font-weight: 900; white-space: nowrap; }

/* ---------- Footer ---------- */
.tapcart-foot {
  display: grid;
  gap: 12px;
  padding: 18px 22px calc(20px + env(safe-area-inset-bottom, 0px));
  border-top: 1px solid rgba(41, 42, 44, .12);
  background: #fff;
}
.tapcart-subtotal { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
.tapcart-subtotal span { color: #6b6e75; font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
.tapcart-subtotal strong { font-size: 24px; font-weight: 900; letter-spacing: -.03em; }
.tapcart-note { margin: 0; color: #6b6e75; font-size: 12px; line-height: 1.6; }
.tapcart-error {
  margin: 0;
  padding: 10px 12px;
  border-radius: 8px;
  background: #fde8e8;
  color: #b42318;
  font-size: 13px;
  line-height: 1.5;
}

.tapcart-checkout {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 16px 18px;
  border: 0;
  border-radius: 999px;
  background: #d51f6d;
  color: #fff;
  font-size: 13px;
  font-weight: 900;
  letter-spacing: .08em;
  cursor: pointer;
  transition: background .18s ease, transform .18s ease, box-shadow .18s ease;
  box-shadow: 0 8px 20px rgba(213, 31, 109, .28);
}
.tapcart-checkout:hover:not(:disabled) { background: #b8175c; transform: translateY(-1px); }
.tapcart-checkout:focus-visible { outline: 2px solid #292a2c; outline-offset: 3px; }
.tapcart-checkout:disabled { background: #c9a3b6; box-shadow: none; cursor: not-allowed; }

.tapcart-continue {
  padding: 10px;
  border: 0;
  background: transparent;
  color: #292a2c;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .08em;
  cursor: pointer;
}
.tapcart-continue:hover { color: #d51f6d; }
.tapcart-continue:focus-visible { outline: 2px solid #d51f6d; outline-offset: 2px; }

/* ---------- Empty state ---------- */
.tapcart-empty {
  display: grid;
  justify-items: center;
  align-content: center;
  gap: 10px;
  min-height: 55%;
  padding: 36px 12px;
  text-align: center;
}
.tapcart-empty-icon {
  display: grid;
  place-items: center;
  width: 84px;
  height: 84px;
  border-radius: 50%;
  background: #f1ece4;
  color: #d51f6d;
}
.tapcart-empty h3 { margin: 8px 0 0; font-size: 22px; font-weight: 900; letter-spacing: -.03em; }
.tapcart-empty p { max-width: 280px; margin: 0 0 10px; color: #6b6e75; font-size: 14px; line-height: 1.65; }
.tapcart-empty .tapcart-checkout { width: auto; padding: 14px 28px; }

@media (max-width: 480px) {
  .tapcart-head { padding: 18px 16px 14px; }
  .tapcart-body { padding: 14px 16px; }
  .tapcart-foot { padding-left: 16px; padding-right: 16px; }
  .tapcart-item { grid-template-columns: 64px minmax(0, 1fr); }
  .tapcart-cover { width: 64px; }
  .tapcart-line-total { grid-column: 2; margin-top: -4px; }
}

@media (prefers-reduced-motion: reduce) {
  .tapcart-overlay, .tapcart-panel, .tapcart-badge-pop { animation: none; }
  .tapcart-trigger, .tapcart-checkout { transition: none; }
}

/* ---------- Add to basket button (original class names) ---------- */
.tap-store-add-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 13px 22px;
  border: 0;
  border-radius: 999px;
  background: #292a2c;
  color: #fff;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: .1em;
  cursor: pointer;
  transition: background .18s ease, transform .18s ease, box-shadow .18s ease;
}
.tap-store-add-button:hover { background: #d51f6d; transform: translateY(-1px); box-shadow: 0 8px 20px rgba(213, 31, 109, .25); }
.tap-store-add-button:focus-visible { outline: 2px solid #d51f6d; outline-offset: 3px; }
.tap-store-add-button svg { flex-shrink: 0; }
.tap-store-add-button.tap-store-add-button--compact { width: 42px; height: 42px; padding: 0; }
.tap-store-add-button.is-added, .tap-store-add-button.is-added:hover { background: #15803d; box-shadow: none; transform: none; }
@media (prefers-reduced-motion: reduce) { .tap-store-add-button { transition: none; } }